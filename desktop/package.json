{
  "name": "chaoquncalender",
  "version": "2.0.0",
  "private": true,
  "description": "chaoquncalender Windows 11 desktop calendar widget",
  "main": "main.cjs",
  "scripts": {
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.zhuangchaoqun.chaoquncalender",
    "productName": "chaoquncalender",
    "directories": { "output": "release" },
    "artifactName": "chaoquncalender-Setup-${version}.${ext}",
    "files": ["main.cjs", "preload.cjs"],
    "win": { "target": "nsis" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "chaoquncalender"
    }
  }
}
