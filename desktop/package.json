{
  "name": "beiocalender",
  "version": "3.3.0",
  "private": true,
  "description": "BEIOCalender Windows 11 desktop calendar widget",
  "main": "main.cjs",
  "scripts": {
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.zhuangchaoqun.chaoquncalender",
    "productName": "BEIOCalender",
    "directories": {
      "output": "release"
    },
    "artifactName": "BEIOCalender-Setup-${version}.${ext}",
    "files": [
      "main.cjs",
      "preload.cjs",
      "offline/**/*",
      "assets/**/*",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "desktop-helper.ps1",
        "to": "desktop-helper.ps1"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://124.223.175.138/chaoquncalender/updates/"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BEIOCalender"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
